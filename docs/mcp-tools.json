  {
    "name": "flight_create_order",
    "description": "Create a flight origin order after price validation. The orderKey must come from flight_verify_solution. Successful origin/change order details expose data.paymentDeadlineAt normalized from lastActionTime.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "orderKey": {
          "type": "string",
          "description": "Order key returned by price validation."
        },
        "externalOrderId": {
          "type": "string",
          "description": "Unique buyer-side external order ID."
        },
        "passengers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "adult",
                  "child",
                  "infant"
                ],
                "description": "Passenger type: adult, child, or infant."
              },
              "surname": {
                "type": "string",
                "description": "Passenger surname / last name in Pinyin or English."
              },
              "givenNames": {
                "type": "string",
                "description": "Passenger given names / first name in Pinyin or English."
              },
              "birthday": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Date of birth in YYYY-MM-DD format."
              },
              "gender": {
                "type": "string",
                "enum": [
                  "male",
                  "female"
                ],
                "description": "Gender."
              },
              "nationality": {
                "type": "string",
                "description": "Nationality country code."
              },
              "travelDocument": {
                "type": "string",
                "enum": [
                  "passport",
                  "tphm",
                  "tptw",
                  "rphmt",
                  "idcard",
                  "fpidcard",
                  "eep",
                  "ttpmr",
                  "hhr"
                ],
                "description": "Travel document type."
              },
              "travelDocumentNumber": {
                "type": "string",
                "description": "Travel document number."
              },
              "travelDocumentExpireDate": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Optional document expiry date in YYYY-MM-DD format."
              },
              "region": {
                "type": "string",
                "description": "Phone region/country code."
              },
              "phone": {
                "type": "string",
                "description": "Passenger phone number."
              },
              "email": {
                "type": "string",
                "format": "email",
                "description": "Optional passenger email."
              },
              "airline": {
                "type": "string",
                "description": "Frequent flyer airline code."
              },
              "cardNo": {
                "type": "string",
                "description": "Frequent flyer card number."
              }
            },
            "required": [
              "type",
              "surname",
              "givenNames",
              "birthday",
              "gender",
              "nationality",
              "travelDocument",
              "travelDocumentNumber",
              "phone"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "description": "Passenger information."
        },
        "contactRegion": {
          "type": "string",
          "description": "Contact phone region/country code."
        },
        "contactPhone": {
          "type": "string",
          "description": "Contact phone."
        },
        "contactEmail": {
          "type": "string",
          "format": "email",
          "description": "Contact email."
        },
        "contactName": {
          "type": "string",
          "description": "Contact name."
        },
        "confirm": {
          "type": "boolean",
          "default": false,
          "description": "Required for write operations. Must be true after the user explicitly confirms the action."
        },
        "confirmProduction": {
          "type": "boolean",
          "default": false,
          "description": "Required when using production API for write operations. Must be true after explicit production-environment confirmation."
        },
        "confirmExternalOrderId": {
          "type": "string",
          "description": "Must match externalOrderId for create-order confirmation."
        }
      },
      "required": [
        "orderKey",
        "externalOrderId",
        "passengers",
        "contactRegion",
        "contactPhone"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
