              },
              "newSegment": {
                "type": "object",
                "properties": {
                  "flightNo": {
                    "type": "string"
                  },
                  "departure": {
                    "type": "string"
                  },
                  "arrival": {
                    "type": "string"
                  },
                  "departureDate": {
                    "type": "string"
                  },
                  "departureTime": {
                    "type": "string"
                  },
                  "arrivalDate": {
                    "type": "string"
