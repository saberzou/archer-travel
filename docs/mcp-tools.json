[
  {
    "name": "flight_search",
    "description": "Search available flights with flexible filtering options. Use data.displayOptions for user-facing flight lists; it is a stable summary built from solution.journeys[].segments[].coreSegmentId and data.segments. Do not parse solutions[].segments directly. Supports up to 5 journey segments for multi-city trips.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "cabinClass": {
          "type": "string",
          "enum": [
            "economy",
            "premium_economy",
            "business",
            "premium_business",
            "first",
            "premium_first"
          ],
          "default": "economy",
          "description": "Cabin class: economy, premium_economy, business, premium_business, first, or premium_first. Defaults to economy."
        },
        "journeys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "Origin city 3-letter IATA code (e.g. BJS for Beijing, SHA for Shanghai)"
              },
              "destination": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "Destination city 3-letter IATA code (e.g. BKK for Bangkok, LAX for Los Angeles)"
              },
              "departureDate": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Departure date in YYYY-MM-DD format. IMPORTANT: If the user input contains only month and day, use getTodayDate to determine the year. For today's date, use getTodayDate instead of hardcoding."
              }
            },
            "required": [
              "origin",
              "destination",
              "departureDate"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 5,
          "description": "Array of journeys (flight segments), at most 5 journeys. Each journey requires origin, destination, and departureDate."
        },
        "adult": {
          "type": "number",
          "minimum": 0,
          "default": 1,
          "description": "Number of adult passengers (age 12+)"
        },
        "child": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Number of child passengers (age 2-11)"
        },
        "infant": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Number of infant passengers (under age 2)"
        },
        "includeAirlines": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "description": "Array of airline codes to include (e.g. ['LX', 'CZ']). If not provided, all airlines are considered."
        },
        "excludeAirlines": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "description": "Array of airline codes to exclude (e.g. ['CA', 'UA']). If not provided, no airlines are excluded."
        },
        "maxDuration": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum flight duration in minutes (e.g. 150 for 2.5 hours)"
        },
        "maxPrice": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum price in CNY"
        },
        "maxSegments": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "description": "Maximum number of flight segments: 0 for any, 1 for nonstop only, 2 for at most 1 stop, 3 for at most 2 stops"
        },
        "mustHaveBag": {
          "type": "boolean",
          "default": false,
          "description": "Require flights that include checked baggage"
        }
      },
      "required": [
        "journeys"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "flight_pricing",
    "description": "Search exact flight prices for known flight numbers and route segments. Use after the user provides a flight number, departure/arrival airport, date, and cabin class.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "passengers": {
          "type": "object",
          "properties": {
            "adult": {
              "type": "integer",
              "minimum": 0,
              "default": 1,
              "description": "Number of adult passengers (age 12+)"
            },
            "child": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "Number of child passengers (age 2-11)"
            },
            "infant": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "Number of infant passengers (under age 2)"
            }
          },
          "additionalProperties": false,
          "description": "Passenger counts."
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "departure": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "Departure airport IATA code."
              },
              "arrival": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "Arrival airport IATA code."
              },
              "departureDate": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Departure date in YYYY-MM-DD format."
              },
              "flightNo": {
                "type": "string",
                "description": "Marketing flight number, e.g. CA1234."
              },
              "cabinClass": {
                "type": "string",
                "enum": [
                  "economy",
                  "premium_economy",
                  "business",
                  "premium_business",
                  "first",
                  "premium_first"
                ],
                "description": "Cabin class."
              },
              "journeyIndex": {
                "type": "integer",
                "minimum": 1,
                "description": "Journey index beginning with 1."
              }
            },
            "required": [
              "departure",
              "arrival",
              "departureDate",
              "flightNo",
              "cabinClass"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 10,
          "description": "Known flight segments to price."
        }
      },
      "required": [
        "passengers",
        "segments"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
